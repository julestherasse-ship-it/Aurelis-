# Proxy /api/leads → Aurelis AI (jamais exposé au navigateur)
AURELIS_AI_URL=https://aurelis-ai-kohl.vercel.app

# Optionnel mais recommandé en production : même valeur côté Aurelis AI
AURELIS_WEBSITE_INGEST_SECRET=

# --- Mesure / Google Ads (IDs publics uniquement — aussi dans assets/config.js) ---
# Ne pas inventer de valeurs. Renseigner après création des comptes.
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=xxxxx/yyyyy
# Conversion principale = generate_lead (demande enregistrée), PAS un clic CTA.

# --- Après immatriculation (référence humaine, pas de secrets site) ---
# Renseigner aussi dans Aurelis AI → Paramètres → Entreprise :
# - companyNumber (BCE)
# - vatNumber (BE0…)
# - legalName, addressLine, postalCode, city
# - iban (facultatif)
# - email pro Aurelis (garder julestherasse@gmail.com tant que non vérifié)
# Puis mettre à jour assets/config.js → company.* et redéployer aurelis.ink
